rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'Alsharji73@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Validation Helpers ---
    function isValidUserPublic(data) {
      return data.keys().hasAll(['uid', 'displayName', 'governorate', 'role', 'level', 'totalPoints', 'isBanned', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'governorate', 'wilayat', 'village', 'role', 'level', 'totalPoints', 'isBanned', 'updatedAt'])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.governorate is string && data.governorate.size() >= 1 && data.governorate.size() <= 60
        && (!('wilayat' in data) || (data.wilayat is string && data.wilayat.size() >= 1 && data.wilayat.size() <= 80))
        && (!('village' in data) || (data.village is string && data.village.size() >= 1 && data.village.size() <= 100))
        && data.role in ['farmer', 'engineer', 'admin']
        && data.level is number && data.level >= 1 && data.level <= 200
        && data.totalPoints is number && data.totalPoints >= 0 && data.totalPoints <= 10000000
        && data.isBanned is bool
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data) {
      return data.keys().hasAll(['uid', 'email', 'notificationsEnabled', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'notificationsEnabled', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 120
        && data.notificationsEnabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFriendship(data) {
      return data.keys().hasAll(['requesterId', 'recipientId', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['requesterId', 'recipientId', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.requesterId)
        && isValidId(data.recipientId)
        && data.requesterId != data.recipientId
        && data.status in ['pending', 'accepted', 'declined']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSeasonalConfig(data) {
      return data.keys().hasAll(['referenceCalendar', 'hijriOffsetDays', 'overrideOccasion', 'enableLanterns', 'enablePatterns', 'updatedAt'])
        && data.keys().hasOnly(['referenceCalendar', 'hijriOffsetDays', 'overrideOccasion', 'ramadanGreeting', 'eidFitrGreeting', 'eidAdhaGreeting', 'enableLanterns', 'enablePatterns', 'updatedAt'])
        && data.referenceCalendar in ['islamic-umalqura', 'islamic-civil', 'oman-official']
        && data.hijriOffsetDays is number && data.hijriOffsetDays >= -3 && data.hijriOffsetDays <= 3
        && data.overrideOccasion in ['auto', 'ramadan', 'eid_fitr', 'eid_adha', 'normal']
        && (!('ramadanGreeting' in data) || (data.ramadanGreeting is string && data.ramadanGreeting.size() <= 200))
        && (!('eidFitrGreeting' in data) || (data.eidFitrGreeting is string && data.eidFitrGreeting.size() <= 200))
        && (!('eidAdhaGreeting' in data) || (data.eidAdhaGreeting is string && data.eidAdhaGreeting.size() <= 200))
        && data.enableLanterns is bool
        && data.enablePatterns is bool
        && data.updatedAt is timestamp;
    }

    function isValidPlantDiagnosis(data) {
      return data.keys().hasAll([
          'userId', 'cropName', 'wilayat', 'observations', 'photoParts',
          'problemName', 'problemType', 'confidenceScore', 'severity',
          'needsClearerPhoto', 'visibleSymptoms', 'causes', 'organicRemedy',
          'chemicalRemedy', 'preventionTips', 'possibleConditions',
          'advisoryNote', 'createdAt'
        ])
        && data.keys().hasOnly([
          'userId', 'cropName', 'wilayat', 'observations', 'photoParts',
          'problemName', 'problemType', 'confidenceScore', 'severity',
          'needsClearerPhoto', 'visibleSymptoms', 'causes', 'organicRemedy',
          'chemicalRemedy', 'preventionTips', 'possibleConditions',
          'advisoryNote', 'createdAt',
          'problemNameEn', 'scientificName', 'diagnosisCategory',
          'detectedSubject', 'insectNature', 'conditionSummary',
          'whenToContactEngineer', 'insectLifeCycle', 'insectTargetCrops',
          'insectDamage', 'pesticideProduct', 'pesticideDosage'
        ])
        && isValidId(data.userId)
        && data.cropName is string && data.cropName.size() >= 1 && data.cropName.size() <= 80
        && data.wilayat is string && data.wilayat.size() >= 1 && data.wilayat.size() <= 100
        && data.observations is string && data.observations.size() <= 1000
        && data.photoParts is list && data.photoParts.size() <= 3
        && data.problemName is string && data.problemName.size() >= 1 && data.problemName.size() <= 160
        && data.problemType in ['مرض', 'حشرة', 'نقص عناصر', 'سليم']
        && data.confidenceScore is number && data.confidenceScore >= 0 && data.confidenceScore <= 100
        && data.severity in ['منخفضة', 'متوسطة', 'عالية', 'حرجة']
        && data.needsClearerPhoto is bool
        && data.visibleSymptoms is string && data.visibleSymptoms.size() <= 1500
        && data.causes is list && data.causes.size() <= 8
        && data.organicRemedy is string && data.organicRemedy.size() <= 2000
        && data.chemicalRemedy is string && data.chemicalRemedy.size() <= 2000
        && data.preventionTips is list && data.preventionTips.size() <= 8
        && data.possibleConditions is list && data.possibleConditions.size() <= 4
        && data.advisoryNote is string && data.advisoryNote.size() <= 500
        && (!('problemNameEn' in data) || (data.problemNameEn is string && data.problemNameEn.size() <= 160))
        && (!('scientificName' in data) || (data.scientificName is string && data.scientificName.size() <= 160))
        && (!('diagnosisCategory' in data) || (data.diagnosisCategory is string && data.diagnosisCategory.size() <= 60))
        && (!('detectedSubject' in data) || data.detectedSubject in ['plant', 'insect', 'unclear'])
        && (!('insectNature' in data) || data.insectNature in ['beneficial', 'harmful', 'neutral', 'none'])
        && (!('conditionSummary' in data) || (data.conditionSummary is string && data.conditionSummary.size() <= 1000))
        && (!('whenToContactEngineer' in data) || (data.whenToContactEngineer is string && data.whenToContactEngineer.size() <= 800))
        && (!('insectLifeCycle' in data) || (data.insectLifeCycle is string && data.insectLifeCycle.size() <= 800))
        && (!('insectTargetCrops' in data) || (data.insectTargetCrops is list && data.insectTargetCrops.size() <= 8))
        && (!('insectDamage' in data) || (data.insectDamage is string && data.insectDamage.size() <= 800))
        && (!('pesticideProduct' in data) || (data.pesticideProduct is string && data.pesticideProduct.size() <= 300))
        && (!('pesticideDosage' in data) || (data.pesticideDosage is string && data.pesticideDosage.size() <= 400))
        && data.createdAt is timestamp;
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll([
          'userId', 'displayName', 'governorate', 'totalPoints',
          'roundsPlayed', 'bestStreak', 'lastGameType', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'displayName', 'governorate', 'totalPoints',
          'roundsPlayed', 'bestStreak', 'lastGameType', 'updatedAt'
        ])
        && isValidId(data.userId)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.governorate is string && data.governorate.size() >= 1 && data.governorate.size() <= 80
        && data.totalPoints is number && data.totalPoints >= 0 && data.totalPoints <= 10000000
        && data.roundsPlayed is number && data.roundsPlayed >= 1 && data.roundsPlayed <= 100000
        && data.bestStreak is number && data.bestStreak >= 0 && data.bestStreak <= 100
        && data.lastGameType in ['knowledge', 'guess_crop', 'plant_doctor', 'true_false', 'speed', 'cultural']
        && data.updatedAt is timestamp;
    }

    // --- 0. Connection Test Doc ---
    match /test/connection {
      allow get: if true;
    }

    // --- 1. Admin Registry ---
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow write: if false;
    }

    // --- 2. Public User Profiles & Private PII Isolation ---
    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if isSignedIn() && resource.data.isBanned == false;

      allow create: if isVerified() && isValidId(userId) && isOwner(userId)
        && isValidUserPublic(incoming())
        && incoming().uid == request.auth.uid
        && incoming().role == 'farmer'
        && incoming().isBanned == false
        && incoming().totalPoints == 0
        && incoming().level == 1
        && incoming().updatedAt == request.time;

      allow update: if isVerified() && isValidId(userId) && isValidUserPublic(incoming()) && (
        isAdmin() || (
          isOwner(userId)
          && incoming().uid == existing().uid
          && incoming().role == existing().role
          && incoming().isBanned == existing().isBanned
          && incoming().totalPoints == existing().totalPoints
          && incoming().level == existing().level
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'governorate', 'wilayat', 'village', 'updatedAt'])
        )
      );

      allow delete: if isAdmin() && isValidId(userId);

      // Strictly isolated PII subcollection
      match /private/info {
        allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow create: if isVerified() && isValidId(userId) && isOwner(userId)
          && isValidUserPrivate(incoming())
          && incoming().uid == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerified() && isValidId(userId) && isValidUserPrivate(incoming()) && (
          isAdmin() || (
            isOwner(userId)
            && incoming().uid == existing().uid
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'notificationsEnabled', 'updatedAt'])
          )
        );
      }

      // Diagnosis history is intentionally disabled: the app provides session-only results.
      // Legacy records can be removed only through the authenticated server-side admin purge.
      match /diagnoses/{diagnosisId} {
        allow read, write: if false;
      }
    }

    // --- 3. Friendships & Competition Invites ---
    match /friendships/{friendshipId} {
      allow get: if isValidId(friendshipId) && isSignedIn()
        && (existing().requesterId == request.auth.uid || existing().recipientId == request.auth.uid || isAdmin());
      allow list: if isSignedIn()
        && (resource.data.requesterId == request.auth.uid || resource.data.recipientId == request.auth.uid);

      allow create: if isVerified() && isValidId(friendshipId)
        && isValidFriendship(incoming())
        && incoming().requesterId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified() && isValidId(friendshipId) && isValidFriendship(incoming()) && (
        isAdmin() || (
          existing().status == 'pending'
          && existing().recipientId == request.auth.uid
          && incoming().requesterId == existing().requesterId
          && incoming().recipientId == existing().recipientId
          && incoming().createdAt == existing().createdAt
          && incoming().status in ['accepted', 'declined']
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        )
      );

      allow delete: if isVerified() && isValidId(friendshipId)
        && (existing().requesterId == request.auth.uid || existing().recipientId == request.auth.uid || isAdmin());
    }

    // --- 5. Global Seasonal Config ---
    match /system/seasonal_config {
      allow get: if true;
      allow create, update: if isAdmin()
        && isValidSeasonalConfig(incoming())
        && incoming().updatedAt == request.time;
    }

    // --- 6. Quiz Leaderboard Entries ---
    match /leaderboard_entries/{userId} {
      allow get: if isValidId(userId);
      allow list: if true;
      allow create: if isVerified() && isValidId(userId) && isOwner(userId)
        && exists(/databases/$(database)/documents/users/$(userId))
        && isValidLeaderboardEntry(incoming())
        && incoming().userId == request.auth.uid
        && incoming().totalPoints <= 1200
        && incoming().roundsPlayed == 1
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(userId) && isOwner(userId)
        && isValidLeaderboardEntry(incoming())
        && incoming().userId == existing().userId
        && incoming().totalPoints >= existing().totalPoints
        && (incoming().totalPoints - existing().totalPoints) <= 1200
        && incoming().roundsPlayed == existing().roundsPlayed + 1
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(userId);
    }
  }
}
